# Variable names invoice-module and its tools read. Placeholder values only.
# Copy to a file OUTSIDE the repository, set mode 600 (chmod 600 <file>) and load it with your
# process manager. Never commit the real file, print it or paste it into logs or chat.
# The sandbox and production credentials are different; keep them in separate files.

# --- Host runtime -----------------------------------------------------------------------------
# An issuer account stores only a reference such as env:SEPAY_EINVOICE. EnvCredentialResolver
# reads the reference name plus _CLIENT_ID and _CLIENT_SECRET (docs/getting-started.md, section 3).
SEPAY_EINVOICE_CLIENT_ID=<sepay-einvoice-client-id>
SEPAY_EINVOICE_CLIENT_SECRET=<sepay-einvoice-client-secret>

# Database for the approvals command line (or pass --database-url).
INVOICE_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>

# --- Sandbox tests (make sandbox) -------------------------------------------------------------
# Put these three in their own env file and point INVOICE_SANDBOX_ENV_FILE at it:
#   INVOICE_SANDBOX_ENV_FILE=~/.config/invoice-module/sepay-einvoice-sandbox.env make sandbox
# The file must declare the sandbox environment; anything else is refused.
SEPAY_EINVOICE_ENVIRONMENT=test
SEPAY_EINVOICE_SANDBOX_CLIENT_ID=<sandbox-client-id>
SEPAY_EINVOICE_SANDBOX_CLIENT_SECRET=<sandbox-client-secret>

# --- Example host (examples/invoice_host) -----------------------------------------------------
# PostgreSQL that is already running; the example host never starts one.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@127.0.0.1:5432/<database>
# Accountant's configuration (keys: examples/invoice_host/accounting-config.example.json),
# or pass --accounting-config.
INVOICE_ACCOUNTING_CONFIG=/path/to/accounting-config.json
# Webhook secret for main.py (payment-module reference env:SEPAY_WEBHOOK_SECRET).
SEPAY_WEBHOOK_SECRET=<webhook-secret>
# serve.py reads this one from its --pm-env file: the secret SePay Test signs its webhooks
# with (HMAC-SHA256). It must equal the secret set on the SePay Test webhook, or every webhook
# gets 401 unauthorized.
SEPAY_TEST_WEBHOOK_SECRET=<sepay-test-webhook-secret>
